  "features": [
    "raw_level",
    "raw_step",
    "raw_abs_step",
    "raw_mean_8",
    "raw_std_8",
    "raw_range_8",
    "raw_detrended_8",
    "raw_drift_8",
    "raw_roughness_8",
    "raw_mean_32",
    "raw_std_32",
    "raw_range_32",
    "raw_detrended_32",
    "raw_drift_32",
    "raw_roughness_32",
    "raw_mean_64",
    "raw_std_64",
    "raw_range_64",
    "raw_detrended_64",
    "raw_drift_64",
    "raw_roughness_64",
    "normal_relative_level",
    "normal_relative_step",
    "normal_relative_abs_step",
    "normal_relative_mean_8",
    "normal_relative_std_8",
    "normal_relative_range_8",
    "normal_relative_detrended_8",
    "normal_relative_drift_8",
    "normal_relative_roughness_8",
    "normal_relative_mean_32",
    "normal_relative_std_32",
    "normal_relative_range_32",
